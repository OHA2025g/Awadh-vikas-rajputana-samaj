# Port the website listens on
PORT=3000

# Long random string used to sign login cookies (generated automatically if empty)
SESSION_SECRET=

# Initial super-admin (only used when the database is created for the first time)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Set to 1 when running behind a reverse proxy such as Nginx / EasyPanel
TRUST_PROXY=

# Uploads, private signatures and WhatsApp session (default: ./data)
DATA_DIR=

NODE_ENV=production

# --- PostgreSQL (EasyPanel: wire the Postgres service into the App) ---
# Preferred: a single URL from the Postgres service
DATABASE_URL=postgres://arvs:arvs@localhost:5432/arvs
# DB_URL is accepted as an alias of DATABASE_URL
# DB_URL=

# Or split fields (EasyPanel often exposes these):
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true

# Port the website listens on
PORT=3000

# Long random string used to sign login cookies (generated automatically if empty)
SESSION_SECRET=

# Initial super-admin (only used when the database is created for the first time)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Set to 1 when running behind a reverse proxy such as Nginx
TRUST_PROXY=

# Where the database, uploads and WhatsApp session are stored (default: ./data)
DATA_DIR=

NODE_ENV=production

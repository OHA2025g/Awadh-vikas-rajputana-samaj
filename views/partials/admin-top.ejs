<%
  const badges = locals.badges || {};
  const nav = [
    { label: 'मुख्य' },
    { href: '/admin', path: '/', icon: 'grid', text: 'डैशबोर्ड', exact: true },
    { label: 'सदस्य प्रबंधन' },
    { href: '/admin/applications', path: '/applications', icon: 'user-check', text: 'सदस्यता आवेदन', badge: badges.applications },
    { href: '/admin/members', path: '/members', icon: 'users', text: 'सदस्य सूची' },
    { href: '/admin/certificates', path: '/certificates', icon: 'printer', text: 'प्रमाण पत्र प्रिंट' },
    { href: '/admin/signatures', path: '/signatures', icon: 'pen-tool', text: 'अधिकृत हस्ताक्षर' },
    { label: 'वित्त एवं अभिलेख' },
    { href: '/admin/donations', path: '/donations', icon: 'gift', text: 'दान एवं भुगतान' },
    { href: '/admin/meetings', path: '/meetings', icon: 'file-text', text: 'बैठक विवरण' },
    { label: 'संचार' },
    { href: '/admin/whatsapp', path: '/whatsapp', icon: 'whatsapp', text: 'व्हाट्सऐप प्रसारण' },
    { href: '/admin/wall', path: '/wall', icon: 'message-circle', text: 'सामुदायिक मंच', badge: badges.wall },
    { label: 'वेबसाइट (CMS)' },
    { href: '/admin/site', path: '/site', icon: 'sliders', text: 'संस्था सेटिंग' },
    { href: '/admin/sections', path: '/sections', icon: 'layout', text: 'अनुभाग एवं पेज' },
    { href: '/admin/r/people', path: '/r/people', icon: 'award', text: 'नेतृत्व एवं ट्रस्टी' },
    { href: '/admin/r/programs', path: '/r/programs', icon: 'book-open', text: 'कार्यक्रम' },
    { href: '/admin/r/events', path: '/r/events', icon: 'calendar', text: 'गतिविधियाँ एवं आयोजन' },
    { href: '/admin/r/mandals', path: '/r/mandals', icon: 'map-pin', text: 'मंडल' },
    { href: '/admin/r/committees', path: '/r/committees', icon: 'briefcase', text: 'समितियाँ' },
    { label: 'सिस्टम' },
    ...(isSuper ? [{ href: '/admin/users', path: '/users', icon: 'shield', text: 'एडमिन उपयोगकर्ता' }] : []),
    { href: '/admin/password', path: '/password', icon: 'lock', text: 'पासवर्ड बदलें' },
  ];
  const isActive = (item) => item.exact ? adminPath === item.path : adminPath === item.path || adminPath.startsWith(item.path + '/');
  const flashIcon = { success: 'check', error: 'alert', info: 'info', warn: 'alert' };
%><!doctype html>
<html lang="hi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="robots" content="noindex, nofollow">
  <title><%= pageTitle %> | एडमिन — <%= site.org_name %></title>
  <link rel="icon" href="<%= site.logo %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;500;600;700;800&family=Rozha+One&family=Tiro+Devanagari+Hindi&family=Kalam:wght@400;700&family=Noto+Serif+Devanagari:wght@500;700&display=swap">
  <link rel="stylesheet" href="/css/admin.css">
  <% (locals.extraStyles || []).forEach((href) => { %><link rel="stylesheet" href="<%= href %>">
  <% }) %>
</head>
<body class="<%= locals.bodyClass || '' %>">
<div class="admin-shell">
  <aside class="sidebar" id="sidebar">
    <a class="sb-brand" href="/admin">
      <img src="<%= site.logo %>" alt="">
      <span><strong><%= site.org_name %></strong><small>प्रशासन पैनल</small></span>
    </a>
    <nav class="sb-nav">
      <% nav.forEach((item) => { %>
        <% if (item.label) { %>
          <div class="sb-label"><%= item.label %></div>
        <% } else { %>
          <a class="sb-link<%= isActive(item) ? ' active' : '' %>" href="<%= item.href %>">
            <%- icon(item.icon) %> <%= item.text %>
            <% if (item.badge) { %><span class="badge solid"><%= item.badge %></span><% } %>
          </a>
        <% } %>
      <% }) %>
    </nav>
    <div class="sb-foot">
      <a href="/" target="_blank" rel="noopener"><%- icon('external-link') %> वेबसाइट देखें</a>
    </div>
  </aside>

  <div class="main">
    <header class="topbar">
      <button class="btn btn-outline btn-icon sb-toggle" type="button" data-sidebar-toggle aria-label="मेनू"><%- icon('menu') %></button>
      <h1><%= pageTitle %></h1>
      <div class="spacer"></div>
      <div class="user-chip">
        <span class="av"><%= initials(admin.name || admin.username) %></span>
        <span class="who"><strong><%= admin.name || admin.username %></strong><br><span class="muted small"><%= ROLE_LABEL[admin.role] %></span></span>
        <form method="post" action="/admin/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-outline btn-sm" type="submit" title="लॉगआउट"><%- icon('log-out') %> <span class="who">लॉगआउट</span></button>
        </form>
      </div>
    </header>
    <main class="content">
      <% if (flash) { %>
        <div class="flash <%= flash.type %>"><%- icon(flashIcon[flash.type] || 'info') %> <span><%= flash.msg %></span></div>
      <% } %>

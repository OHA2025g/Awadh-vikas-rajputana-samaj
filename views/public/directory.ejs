<%- include('../partials/header') %>

<section class="page-hero">
  <div class="container">
    <div class="crumbs"><a href="/">मुखपृष्ठ</a> / सदस्य निर्देशिका</div>
    <h1>सदस्य निर्देशिका</h1>
    <p>संघ के प्रमुख, पदाधिकारी एवं सभी सदस्यों की सूची — मंडल, समिति या नाम से खोजें।</p>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="container" id="directory-app" data-initial-category="<%= initialCategory %>">
    <div class="dir-tabs" role="tablist">
      <button class="dir-tab" type="button" data-category="" role="tab"><%- icon('grid') %> सभी <span class="count" data-count="all"><%= counts.all %></span></button>
      <button class="dir-tab" type="button" data-category="pramukh" role="tab"><%- icon('award') %> प्रमुख <span class="count" data-count="pramukh"><%= counts.pramukh %></span></button>
      <button class="dir-tab" type="button" data-category="padadhikari" role="tab"><%- icon('shield') %> पदाधिकारी <span class="count" data-count="padadhikari"><%= counts.padadhikari %></span></button>
      <button class="dir-tab" type="button" data-category="sadasya" role="tab"><%- icon('users') %> सदस्य <span class="count" data-count="sadasya"><%= counts.sadasya %></span></button>
    </div>

    <div class="filters">
      <label class="input-icon">
        <span class="sr-only">खोजें</span>
        <%- icon('search') %>
        <input type="search" id="dir-q" placeholder="नाम, सदस्य क्रमांक या शहर से खोजें…" autocomplete="off">
      </label>
      <select id="dir-mandal" aria-label="मंडल">
        <option value="">सभी मंडल</option>
        <% for (const m of mandals) { %><option value="<%= m.id %>"><%= m.name %></option><% } %>
      </select>
      <select id="dir-committee" aria-label="समिति">
        <option value="">सभी समितियाँ</option>
        <% for (const c of committees) { %><option value="<%= c.id %>"><%= c.name %></option><% } %>
      </select>
      <button class="btn btn-outline" type="button" id="dir-reset"><%- icon('rotate-ccw') %> रीसेट</button>
    </div>

    <div class="mandal-chips" id="mandal-chips">
      <button class="chip active" type="button" data-mandal="">सभी मंडल</button>
      <% for (const m of mandals) { %><button class="chip" type="button" data-mandal="<%= m.id %>" title="<%= m.description || '' %>"><%= m.name %></button><% } %>
    </div>

    <div class="result-info" id="dir-info" aria-live="polite">लोड हो रहा है…</div>
    <div class="member-grid" id="dir-grid"></div>
    <div class="pager" id="dir-pager"></div>

    <p class="privacy-note"><%- icon('lock') %> सदस्यों की गोपनीयता हेतु मोबाइल नंबर आंशिक रूप से छिपाए गए हैं। पूरी जानकारी के लिए संघ कार्यालय से संपर्क करें।</p>
  </div>
</section>

<%- include('../partials/footer', { scripts: ['/js/directory.js'] }) %>

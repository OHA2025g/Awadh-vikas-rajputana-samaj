<!doctype html>
<html lang="hi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>सदस्यता फॉर्म — <%= m.name %> | <%= site.org_name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;500;600;700;800&family=Rozha+One&display=swap">
  <link rel="stylesheet" href="/css/membership-form.css">
</head>
<body class="mf-print-page">
  <div class="mf-toolbar mf-noprint">
    <button type="button" data-print>प्रिंट करें (A4)</button>
    <a href="<%= m.status === 'pending' ? '/admin/applications/' + m.id : '/admin/members/' + m.id + '/edit' %>">वापस</a>
  </div>
  <%- include('../partials/membership-form', { mf: { mode: 'view', m, secure: isSuper, dateText: formDate } }) %>
  <script src="/js/print-page.js"></script>
</body>
</html>

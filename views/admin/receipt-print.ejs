<!doctype html>
<html lang="hi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>रसीद <%= receipts.map((r) => r.receipt_no).join(', ') %> | <%= site.org_name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;500;600;700;800&display=swap">
  <% if (locals.inlineCss) { %><style><%- inlineCss %></style><% } else { %><link rel="stylesheet" href="/css/receipt.css"><% } %>
  <% if (locals.single) { %><style>@page { size: 210mm 148.5mm; margin: 0; }</style><% } %>
</head>
<body<%- locals.single ? ' class="rc-single"' : '' %>>
<%
  const swastik =
    '<svg class="rc-sw" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12V4h7M12 12h8v7M12 12v8H5M12 12H4V5"/>' +
    '<circle cx="8" cy="8" r="1.5"/><circle cx="16" cy="8" r="1.5"/><circle cx="16" cy="16" r="1.5"/><circle cx="8" cy="16" r="1.5"/></svg>';
  const bars = `<span class="rc-bars">॥${swastik}॥</span>`;
  const pages = [];
  for (let i = 0; i < receipts.length; i += 2) pages.push(receipts.slice(i, i + 2));
  const bank = [
    ['Bank Details', site.bank_name],
    ['Account Holder Name', site.bank_account_name],
    ['Branch Add.', site.bank_branch],
    ['A/C No.', site.bank_account_no],
    ['IFSC CODE', site.bank_ifsc],
  ].filter(([, v]) => v);
%>
  <% if (!locals.single) { %>
  <div class="rc-toolbar rc-noprint">
    <button type="button" data-print>प्रिंट करें (A4 — एक पेज पर 2 रसीदें)</button>
    <a href="/admin/donations">वापस</a>
    <span><%= receipts.length %> रसीद • प्रिंट सेटिंग: Paper A4, Margins None, Scale 100%, Background graphics चालू</span>
  </div>
  <% } %>

  <% pages.forEach((pair) => { %>
  <div class="rc-page">
    <% pair.forEach((r) => { %>
    <section class="rc">
      <div class="rc-box">
        <header class="rc-head">
          <img class="rc-logo" src="<%= site.logo %>" alt="">
          <div class="rc-top">
            <span class="rc-om">॥ ॐ श्री गणेशाय नमः ॥</span>
            <% if (site.reg_no) { %><span class="rc-reg">रजि.नंबर : <%= site.reg_no %></span><% } %>
          </div>
          <h1 class="rc-org"><%- bars %><span><%= site.org_name %></span><%- bars %></h1>
          <p class="rc-addr"><%= site.address %></p>
          <p class="rc-contact">
            <% if (site.email) { %>Email : <%= site.email %><% } %><% if (site.email && site.phone) { %> | <% } %><% if (site.phone) { %>Mob.: <%= site.phone %><% } %>
          </p>
        </header>

        <div class="rc-meta">
          <div class="rc-meta-no"><span class="rc-l">क्रमांक :</span> <b class="rc-no"><%= r.receipt_no %></b></div>
          <div class="rc-badge">RECEIPT</div>
          <div class="rc-meta-date"><span class="rc-l">दिनांक :</span> <span class="rc-fill"><%= r.date_out %></span></div>
        </div>

        <div class="rc-body">
          <div class="rc-line">
            <span class="rc-l">श्रीमान/श्रीमती</span>
            <span class="rc-fill grow"><%= r.name %></span>
            <span class="rc-l">मोबा.:</span>
            <span class="rc-fill w-phone"><%= r.phone_out %></span>
          </div>
          <div class="rc-line">
            <span class="rc-l">निवासस्थान :</span>
            <span class="rc-fill grow"><%= r.residence %></span>
          </div>
          <div class="rc-line rc-bullet">
            <span class="rc-l">राशि (अंकों में)</span>
            <span class="rc-fill w-amount"><%= r.amount_out %></span>
            <span class="rc-l">राशि (शब्दों में)</span>
            <span class="rc-fill grow"><%= r.words_out %></span>
          </div>
          <div class="rc-line rc-bullet">
            <span class="rc-l">भुगतान का माध्यम :</span>
            <span class="rc-fill grow"><%= r.mode_out %></span>
          </div>
          <div class="rc-line rc-bullet rc-reasons">
            <span class="rc-l">प्राप्त कारण :</span>
            <% reasons.forEach((reason) => { %>
              <span class="rc-reason"><%= reason.label %><span class="rc-tick"><%= r.category === reason.key ? '✓' : '' %></span></span>
            <% }) %>
          </div>
          <% if (r.details) { %>
          <div class="rc-line rc-details">
            <span class="rc-l">विवरण :</span>
            <span class="rc-fill grow"><%= r.details %></span>
          </div>
          <% } %>
        </div>

        <footer class="rc-foot">
          <ul class="rc-bank">
            <% bank.forEach(([label, value]) => { %><li><%= label %> : <%= value %></li><% }) %>
          </ul>
          <% if (qr) { %>
            <div class="rc-qr"><img src="<%= qr %>" alt="QR"><span>QR FOR ONLINE</span></div>
          <% } %>
          <div class="rc-sig">
            <span class="rc-sigline"></span>
            <span>जमाकर्ता का हस्ताक्षर</span>
          </div>
          <div class="rc-office">
            <b><%= site.org_name %></b>
            <span class="rc-sigline"></span>
            <span>प्राप्तकर्ता का हस्ताक्षर</span>
            <div class="rc-fullname"><span>• पूर्ण नाम</span><span class="rc-fill grow"></span></div>
          </div>
        </footer>
      </div>
    </section>
    <% }) %>
  </div>
  <% }) %>

  <% if (!locals.single) { %><script src="/js/print-page.js"></script><% } %>
</body>
</html>

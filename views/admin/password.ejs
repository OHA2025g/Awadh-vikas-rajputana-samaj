<%- include('../partials/admin-top') %>

<div style="max-width:560px">
  <% if (admin.must_change_password) { %>
    <div class="flash warn"><%- icon('lock') %> <span>सुरक्षा हेतु आगे बढ़ने से पहले कृपया डिफ़ॉल्ट पासवर्ड बदलें।</span></div>
  <% } %>
  <% if (error) { %>
    <div class="flash error"><%- icon('alert') %> <span><%= error %></span></div>
  <% } %>
  <form class="card" method="post" action="/admin/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-head"><h2><%- icon('lock') %> पासवर्ड बदलें</h2></div>
    <div class="card-body stack">
      <div class="field">
        <label for="current_password">वर्तमान पासवर्ड</label>
        <input type="password" id="current_password" name="current_password" autocomplete="current-password" required>
      </div>
      <div class="field">
        <label for="new_password">नया पासवर्ड</label>
        <input type="password" id="new_password" name="new_password" autocomplete="new-password" minlength="8" required>
        <div class="hint">कम से कम 8 अक्षर।</div>
      </div>
      <div class="field">
        <label for="confirm_password">नया पासवर्ड दोबारा</label>
        <input type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" minlength="8" required>
      </div>
    </div>
    <div class="form-actions">
      <button class="btn btn-primary" type="submit"><%- icon('save') %> पासवर्ड सहेजें</button>
    </div>
  </form>
</div>

<%- include('../partials/admin-bottom') %>
